{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "asantibanez/laravel-eloquent-state-machines": "^6.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "bezhansalleh/filament-shield": "^4.0",
        "brick/money": "^0.10.1",
        "calebporzio/sushi": "^2.5",
        "codeat3/blade-file-icons": "^1.10",
        "codeat3/blade-simple-icons": "^7.16",
        "dyrynda/laravel-cascade-soft-deletes": "^4.5",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "hugomyb/filament-error-mailer": "^5.1",
        "joaopaulolndev/filament-pdf-viewer": "^3.0",
        "lara-zeus/qr": "^3.0",
        "lara-zeus/simple-qrcode": "^5.0",
        "laravel/framework": "^11.9",
        "laravel/octane": "^2.13",
        "laravel/socialite": "^5.16",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^4.0",
        "moneyphp/money": "^4.7",
        "njxqlus/filament-relation-manager-component": "^2.0",
        "opcodesio/log-viewer": "^3.15",
        "orangehill/iseed": "^3.0",
        "rap2hpoutre/fast-excel": "^5.5",
        "revolution/laravel-google-sheets": "^7.1",
        "secondnetwork/blade-tabler-icons": "^3.41",
        "spatie/laravel-pdf": "^1.5",
        "stechstudio/filament-impersonate": "^5.0",
        "tapp/filament-auditing": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel-shift/blueprint": "^2.10",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers_money.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": {
                "PKSA-mdq4-51ck-6kdq": "XSS en modo debug / sin parche disponible; mitigado con APP_DEBUG=false en produccion",
                "PKSA-8qx3-n5y5-vvnd": "XSS en modo debug / sin parche disponible; mitigado con APP_DEBUG=false en produccion",
                "PKSA-q46n-4fdk-zjr4": "SBA-ADV-20241209-02 Reflected XSS via Route Parameter en pagina de error de debug; requiere APP_DEBUG=true",
                "PKSA-qzrn-rnz3-85w1": "SBA-ADV-20241209-01 Reflected XSS via Request Parameter en pagina de error de debug; requiere APP_DEBUG=true",
                "PKSA-w7xr-vk7n-rstm": "XSS en modo debug / sin parche disponible; mitigado con APP_DEBUG=false en produccion"
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
